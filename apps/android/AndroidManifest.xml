<?xml version="1.0" encoding="utf-8"?>
<!-- The Hemma app for Android (2.0; apps/android/README.md): Hemma's own pages in a window of its own, found on the
     home network by itself. The version comes from the VERSION file (build.sh / build.ps1 pass it to aapt2). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.kloparn.hemma">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the Wi-Fi's own address and size: the addresses to look through -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17 on: "devices on your local network" - asked for at the first start (MainActivity), else no
         connection to Hemma at home gets through -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- an audiobook playing with the phone locked: a media notification, the CPU and the Wi-Fi kept awake -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Hemma is plain http on the home network: the app itself refuses anything that isn't (Net.java) -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Hemma">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
